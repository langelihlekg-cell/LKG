# Anything regenerated by running the code shouldn't be committed — these
# are exactly the files that caused "your local changes would be
# overwritten by merge" the first time an update was pulled.

venv/
__pycache__/
*.pyc

devserver/*.log
devserver/devserver.sqlite3*
devserver/storage/
devserver/downloaded_square.mov

test_assets/output_*/
test_assets/week1_output/
*.mp4
*.mov
